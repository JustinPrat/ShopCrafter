  m_Name: ObjectiveData
  m_EditorClassIdentifier: Scriptmaker.Editor::ScriptMaker.Editor.ScriptMakerTemplate
  scriptBody: "using UnityEngine;\r\n\r\n[CreateAssetMenu(fileName = \"{ScriptName}\", menuName = \"ShopCrafter/Milestone/{ScriptName}\")]\r\npublic class {ScriptName}Data : ObjectiveData\r\n{\n\r\n    public override ObjectiveBehavior GetObjectiveBehavior()\r\n    {\r\n        {ScriptName}Behavior objectiveBehavior = new {ScriptName}Behavior();\r\n        objectiveBehavior.Setup(this);\r\n        return objectiveBehavior;\r\n    }\r\n\r\n    public class {ScriptName}Behavior : ObjectiveBehavior\r\n    {\r\n        private {ScriptName}Data data;\r\n        public override ObjectiveData Data => data;\r\n\r\n        public void Setup({ScriptName}Data data)\r\n        {\r\n            this.data = data;\r\n        }\r\n\r\n        public override void OnStartObjective()\r\n        {\r\n        }\r\n\r\n        public override void OnStopObjective()\r\n        {\r\n        }\r\n    }\r\n}"
  scriptNameSuffix: Data
