  m_Script: {fileID: 11500000, guid: 04e359d2acf72bf4a95d65818e2f7376, type: 3}
  m_Name: QuestStepData
  m_EditorClassIdentifier: Scriptmaker.Editor::ScriptMaker.Editor.ScriptMakerTemplate
  scriptBody: "using System.Collections.Generic;\r\nusing UnityEngine;\r\n\r\n[CreateAssetMenu(menuName = \"ShopCrafter/Quests/{ScriptName}QuestStepData\")]\r\npublic class {ScriptName}QuestStepData : QuestStepData\r\n{\n    [SerializeField]\r\n    private QuestStepDisplayData stepDisplayData;\r\n    public override QuestStepDisplayData QuestStepUIDisplayData => stepDisplayData;\n\r\n    public override QuestStepRuntime GetRuntimeLogic()\r\n    {\r\n        return new {ScriptName}QuestStepRuntime(this);\r\n    }\r\n}\r\n\r\npublic class {ScriptName}QuestStepRuntime : QuestStepRuntime\r\n{\r    private {ScriptName}QuestStepData data;\n\r\n    public {ScriptName}QuestStepRuntime({ScriptName}QuestStepData data)\r\n    {\r\n        this.data = data;\r\n    }\r\n\r\n    public override void InitializeQuestStep(string questId, int stepIndex, string questStepState, ManagerRefs managerRefs, PNJBrain owner)\r\n    {\r\n        base.InitializeQuestStep(questId, stepIndex, questStepState, managerRefs, owner);\r\n    }\r\n\r\n    protected override void FinishQuestStep()\r\n    {\r\n        base.FinishQuestStep();\r\n    }\r\n\r\n    protected override void SetQuestStepState(string state)\r\n    {\r\n    }\r\n}"
  scriptNameSuffix: QuestStepData
