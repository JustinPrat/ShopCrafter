  m_Script: {fileID: 11500000, guid: 04e359d2acf72bf4a95d65818e2f7376, type: 3}
  m_Name: SequenceActionData
  m_EditorClassIdentifier: Scriptmaker.Editor::ScriptMaker.Editor.ScriptMakerTemplate
  scriptBody: "using System.Collections;\r\nusing UnityEngine;\r\n\r\nnamespace Sequencer.Actions\r\n{\r\n   
    [CreateAssetMenu(fileName = \"{ScriptName}Data\", menuName = \"Sequencer/{ScriptName}Data\")]\r\n   
    public class {ScriptName}Data : SequenceActionData\r\n    {\r\n        public
    override SequenceActionBehavior CreateBehavior(GameObject owner)\r\n        {\n           
    {ScriptName}Behavior behavior = new {ScriptName}Behavior();\r\n            behavior.Setup(this,
    owner);\r\n            return behavior;\r\n        }\r\n\r\n        public class
    {ScriptName}Behavior : SequenceActionBehavior\r\n        {\r\n            private
    {ScriptName}Data data;\r\n\r\n            public void Setup({ScriptName}Data
    data, GameObject owner)\r\n            {\n\t\tthis.data = data;\n\t\tthis.owner
    = owner;\r\n            }\r\n\r\n            public override IEnumerator Execute()\r\n           
    {\r\n                yield return null;\r\n            }\n\n            public
    override void Stop()\r\n            {\r            }\r\n        }\r\n    }\r\n}"
  scriptNameSuffix: Data
