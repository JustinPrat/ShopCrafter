  m_Script: {fileID: 11500000, guid: 04e359d2acf72bf4a95d65818e2f7376, type: 3}
  m_Name: SequenceAction
  m_EditorClassIdentifier: Scriptmaker.Editor::ScriptMaker.Editor.ScriptMakerTemplate
  scriptBody: "using System.Collections;\r\nusing UnityEngine;\r\n\r\nnamespace Sequencer.Actions\r\n{\r\n   
    [CreateAssetMenu(fileName = \"{ScriptName}Data\", menuName = \"Sequencer/{ScriptName}Data\")]\r\n   
    public class {ScriptName}Data : SequenceActionData\r\n    {\r\n        public
    override SequenceActionBehavior CreateBehavior(GameObject owner)\r\n        {\r\n           
    return new {ScriptName}Behavior(owner, this);\r\n        }\r\n\r\n        public
    class {ScriptName}Behavior : SequenceActionBehavior\r\n        {\r\n           
    private {ScriptName}Data data;\r\r\n            public {ScriptName}Behavior(GameObject
    owner, {ScriptName}Data data) : base(owner)\r\n            {\r\n               
    this.data = data;\r\n            }\r\n\r\n            public override void Setup()\r\n           
    {\r\n            }\r\n\r\n            public override IEnumerator Execute()\r\n           
    {\r\n                yield return null;\r\n            }\r\n        }\r\n   
    }\r\n}"
  scriptNameSuffix: Data
